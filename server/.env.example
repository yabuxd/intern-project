APP_NAME="Restaurant Order API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local-only: SQLite is fine for unit tests. For app speed + Realtime, use Supabase Postgres.
# Do not store cache/sessions/queues in the database.
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- Supabase Postgres (transaction pooler — preferred) ---
# Dashboard → Project Settings → Database → Connection string → Transaction pooler
# Username is usually postgres.<project-ref> on the pooler (not plain "postgres").
# Pick the pooler region that matches your project (example: eu-west-1).
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# DB_PORT=6543
# DB_PGBOUNCER=true
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-database-password
# DB_SSLMODE=require
#
# Direct host (db.<ref>.supabase.co:5432) often fails DNS on some networks; prefer the pooler.
# Session pooler (port 5432 on *.pooler.supabase.com) if migrations need full session features.

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
# Publishable / anon key (safe for client; also used by server Auth introspection)
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Secret key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
# Optional legacy JWT secret (HS256). New Supabase projects use ES256 JWKS;
# Laravel verifies via JWKS, then GET /auth/v1/user when this is empty.
SUPABASE_JWT_SECRET=

# Optional: path to a CA bundle (cacert.pem). Needed on some Windows PHP installs
# when outbound HTTPS to Supabase fails with cURL error 60.
# SSL_CERT_FILE=C:/path/to/cacert.pem

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Seeded admin (set real values in server/.env — never commit passwords)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Restaurant Admin"
# Optional if the Auth user already exists
ADMIN_USER_ID=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
